+  // Probe a candidate AI spec the same way a human would: place it, run a
+  // short fixed-duration settle, read the receipt. Used by the explore loop
+  // (build → test → adjust → test again). loadCircuitSpec still owns commit.
+  function probeAiSpec(spec) {
+    try {
+      loadCircuitSpec({ ...spec, layout: spec.layout || currentLayoutKey });
+    } catch (err) {
+      return { ok: false, errors: [err.message], committed: false, summary: '' };
+    }
+    let receipt;
+    try {
+      // Short settle: enough for DC LED/divider; RC templates still get a first look.
+      receipt = runDuration(0.05, 0.001);
+      document.getElementById('simReceipt').value = JSON.stringify(receipt, null, 2);
+    } catch (err) {
+      return { ok: false, errors: [err.message], committed: true, summary: '' };
+    }
+    const summary = AIBuilder.summarizeReceipt(receipt);
+    const errors = [];
+    if (AIBuilder.receiptLooksBad(receipt)) {
+      const warnings = receipt.warnings || [];
+      errors.push('Simulation warnings: ' + (warnings.length ? warnings.join(' | ') : 'unhealthy receipt'));
+    }
+    return { ok: errors.length === 0, errors, receipt, summary, committed: true };
+  }
