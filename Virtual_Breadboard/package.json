{
  "name": "star-forge-digital-bread-board",
  "version": "1.0.0",
  "description": "Star Forge Digital Bread Board: local electronics practice bench with live circuit physics and Pedal Lab modules.",
  "main": "main.js",
  "private": true,
  "homepage": "https://github.com/One-Wave-Universe/One-Wave-Science",
  "scripts": {
    "start": "electron .",
    "test": "node test/circuit.test.js",
    "test:tuner": "node test/circle-fifths-tuner.test.js",
    "test:qualification": "node test/qualification.test.js",
    "test:primitives": "node test/primitives.test.js",
    "test:regression": "node test/run_regression_builds.js",
    "test:flashlight-calibration": "node test/run_flashlight_calibration.js",
    "test:flashlight-reference": "node test/conventional-flashlight-reference.test.js",
    "test:netlist": "node test/netlist.test.js",
    "test:fault-states": "node test/fault-states.test.js",
    "test:basic-circuits": "node test/basic-circuits.test.js",
    "test:normal-circuits": "node test/normal-circuits-reality.test.js",
    "receipts": "node 10_RECEIPTS/generate_receipts.js",
    "simulate": "node simulate.js",
    "dist": "electron-builder",
    "dist:appimage": "electron-builder --linux AppImage",
    "dist:deb": "electron-builder --linux deb",
    "dist:win": "electron-builder --win portable zip",
    "dist:win-installer": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac zip",
    "dist:mac-dmg": "electron-builder --mac dmg",
    "bundle": "node build-standalone.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.onewavescience.starforge",
    "productName": "Star Forge Digital Bread Board",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "js/**/*",
      "build/icon.png",
      "!test/**"
    ],
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64", "arm64"] },
        { "target": "deb", "arch": ["x64", "arm64"] }
      ],
      "category": "Education",
      "executableName": "star-forge-digital-bread-board",
      "icon": "build/icon.png",
      "maintainer": "One Wave Science <opensource@one-wave-universe.example>"
    },
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Star Forge Digital Bread Board"
    }
  }
}
