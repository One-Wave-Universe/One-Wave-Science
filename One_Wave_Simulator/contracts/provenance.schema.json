{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "one-wave/provenance-v1",
  "title": "Provenance Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_manifest", "input_record_ids", "software", "transform", "created_at_utc"],
  "properties": {
    "source_manifest": {"type": "string"},
    "input_record_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "software": {"type": "object"},
    "transform": {"type": "object"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "random_seed": {"type": ["integer", "null"]},
    "notes": {"type": "string"}
  }
}
