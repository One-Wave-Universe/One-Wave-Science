{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "one-wave/normalized-observation-v1",
  "title": "Normalized Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "source", "observation_kind", "coordinates", "units", "observables", "normalization"],
  "properties": {
    "schema_version": {"const": "normalized-observation-v1"},
    "status": {"const": "NORMALIZED"},
    "source": {"type": "object"},
    "observation_kind": {"type": "string", "minLength": 1},
    "coordinates": {"type": "object"},
    "units": {"type": "object"},
    "observables": {"type": "object"},
    "normalization": {"type": "object"}
  }
}
