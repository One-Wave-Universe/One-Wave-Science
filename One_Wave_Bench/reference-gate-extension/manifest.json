{
  "manifest_version": 3,
  "name": "One-Wave Reference Gate",
  "version": "0.1.0",
  "description": "Require a One-Wave reference card before outbound AI/web submissions on configured sites.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "One-Wave Reference Gate",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
