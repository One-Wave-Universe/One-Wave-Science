# Never feed repository metadata, caches, generated outputs, or large binaries by accident.
.git/
.github/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/node_modules/
**/dist/
**/build/
**/*.pyc
**/*.pyo
**/*.so
**/*.a
**/*.o
**/*.bin
**/*.iso
**/*.img
**/*.zip
**/*.tar
**/*.gz
**/*.7z
**/*.pdf
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.gif
**/*.mp3
**/*.wav
**/*.mp4
**/*.mov
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.log

# Local secrets / credentials must never enter model context.
.env
.env.*
!.env.example
.gemini/.env
.gemini/.env.*
**/*secret*
**/*credential*
**/*token*.txt
**/*api_key*
