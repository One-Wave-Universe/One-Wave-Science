{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "one-wave/source-manifest-v1",
  "title": "One Wave Source Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "facility", "dataset_id", "retrieved_at_utc", "access_terms", "records"],
  "properties": {
    "schema_version": {"const": "source-manifest-v1"},
    "facility": {"enum": ["LIGO", "CERN", "OTHER"]},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_release": {"type": "string"},
    "source_url": {"type": "string", "format": "uri"},
    "retrieved_at_utc": {"type": "string", "format": "date-time"},
    "access_terms": {"type": "string", "minLength": 1},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {"type": "string"},
        "digest": {"type": "string"}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "path", "content_type"],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "content_type": {"type": "string", "minLength": 1},
          "checksum": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
