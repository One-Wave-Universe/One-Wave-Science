      "octave disappears under controls/refinement"
    ]
  },
  "state_schema": "../../../00-state-container/state-schema.json",
  "adapter": {
    "existing": "../../../00-lattice-primitive",
    "entry_point": "adapter.js",
    "node_bindings": [
      "G-764"
