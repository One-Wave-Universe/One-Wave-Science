{
  "schema": "one-wave-sandbox-module/v1",
  "id": "lattice-primitive",
  "name": "Six-neighbor lattice primitive",
  "version": "0.1.0",
  "slot": 1,
  "claim_gate": "YELLOW",
  "dimensions": [
    "2d"
  ],
  "solver": {
    "kind": "finite-difference lattice",
    "equations": [
      "G-764/G-766 six-neighbor control"
