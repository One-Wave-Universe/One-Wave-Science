{
  "transform": "cern_nanoaod_to_one_wave_v0",
  "raw_required": ["event_id", "pt", "phi", "eta"],
  "point": {
    "amplitude": "pt",
    "phase": "phi",
    "inclination": "eta",
    "x": "pt*cos(phi)",
    "y": "pt*sin(phi)"
  },
  "event": {
    "scalar_strength": "sum(pt)",
    "net_x": "sum(pt*cos(phi))",
    "net_y": "sum(pt*sin(phi))",
    "net_amplitude": "sqrt(net_x^2+net_y^2)",
    "net_phase": "atan2(net_y,net_x)",
    "coherence": "net_amplitude/scalar_strength"
  },
  "lean": {
    "formula": "50 + 50*(S_plus-S_minus)/(S_plus+S_minus)",
    "bands": {
      "90_100": "EXTREME_EXPRESSION_DANGER",
      "75_85": "STRONG_EXPRESSION",
      "60_70": "MODERATE_EXPRESSION",
      "45_55": "ACTIVE_MIDDLE",
      "30_40": "MODERATE_COMPRESSION",
      "15_25": "STRONG_COMPRESSION",
      "0_10": "EXTREME_COMPRESSION_DANGER"
    },
    "gaps": ["85_90","70_75","55_60","40_45","25_30","10_15"]
  }
}
